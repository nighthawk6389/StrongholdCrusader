{
  "name": "modern-siege-rts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-player modern-military castle-siege RTS for the browser (working title TBD).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
